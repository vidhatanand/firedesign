{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "vue": ["./node_modules/vue"],
      "vue/*": ["./node_modules/vue/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.json"],
  "vueCompilerOptions": { "strictTemplates": false }
}
