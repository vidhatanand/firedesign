{
  "id": "endpoint",
  "job": "Name an API call by its method and path wherever it appears.",
  "purpose": "A method tag and a path in mono. The method carries a tone so a destructive call is recognisable at a glance: GET info, POST success, PUT and PATCH warning, DELETE danger. Path parameters in braces are emphasised. Make it a button with data-copyable to copy the path on click.",
  "useWhen": [
    "A docs heading, a log row or a usage table names an endpoint.",
    "A reader should copy the path with one click."
  ],
  "avoidWhen": [
    {
      "when": "A whole request with headers and body.",
      "instead": "codeblock"
    },
    {
      "when": "A short status word.",
      "instead": "badge"
    },
    {
      "when": "A command to run.",
      "instead": "snippet"
    },
    {
      "when": "The parameters of the call.",
      "instead": "schema"
    }
  ],
  "aka": [
    "route",
    "API path",
    "HTTP method",
    "verb and path",
    "request line",
    "URL pattern"
  ],
  "surfaces": [
    "app",
    "website"
  ],
  "data": [
    "text"
  ],
  "states": [
    {
      "name": "copied",
      "how": "data-state=\"copied\" for a moment after a copyable endpoint is pressed"
    }
  ],
  "variants": [
    {
      "attribute": "data-method",
      "value": "get",
      "useWhen": "A read call; info tone."
    },
    {
      "attribute": "data-method",
      "value": "post",
      "useWhen": "A create call; success tone."
    },
    {
      "attribute": "data-method",
      "value": "put",
      "useWhen": "A replace call; warning tone."
    },
    {
      "attribute": "data-method",
      "value": "patch",
      "useWhen": "A partial update; warning tone."
    },
    {
      "attribute": "data-method",
      "value": "delete",
      "useWhen": "A destructive call; danger tone."
    },
    {
      "attribute": "data-variant",
      "value": "plain",
      "useWhen": "No frame, inside a table or a heading."
    },
    {
      "attribute": "data-size",
      "value": "sm",
      "useWhen": "A 22px pill for dense rows."
    }
  ],
  "parts": [
    {
      "class": "fd-endpoint",
      "role": "The pill."
    },
    {
      "class": "fd-endpoint-method",
      "role": "The method tag."
    },
    {
      "class": "fd-endpoint-path",
      "role": "The path."
    },
    {
      "class": "fd-endpoint-param",
      "role": "A path parameter in braces, in the accent."
    },
    {
      "class": "fd-endpoint-copy",
      "role": "The copy icon of a copyable endpoint."
    }
  ],
  "related": [
    "codeblock",
    "badge",
    "schema",
    "snippet"
  ],
  "keyboard": [
    {
      "keys": "Enter, Space",
      "does": "On a copyable endpoint, copies the path."
    }
  ],
  "example": "docs/code.html#endpoint",
  "provenance": [
    "docs/code.html",
    "fire/components/code.css",
    "fire/js/code.js"
  ],
  "since": "0.1.0"
}
