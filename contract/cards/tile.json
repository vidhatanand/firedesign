{
  "id": "tile",
  "job": "Hold a logo, a glyph or one or two letters in a square.",
  "purpose": "A square holder, 36px by default, that steps through 20, 28, 40, 44 and 56 with a growing radius. It holds an image, an icon or letters. Tone tints it; data-shape gives a circle or a wide stat tile. Use letter tiles or glyphs for providers, not brand colours.",
  "useWhen": [
    "A row or card needs a mark for what it is: a provider, an integration, a key type.",
    "A feature list or empty state needs a leading icon holder."
  ],
  "avoidWhen": [
    {
      "when": "The mark is a person.",
      "instead": "avatar"
    },
    {
      "when": "A label next to a word.",
      "instead": "badge"
    },
    {
      "when": "A figure with a label.",
      "instead": "stats"
    },
    {
