{
  "name": "fire-vue-vite-starter",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Fire starter: Vue 3, Vite and vue-router, TypeScript, strict CSP.",
  "scripts": {
    "theme": "node scripts/build-theme.mjs",
    "dev": "npm run theme && vite",
    "build": "npm run theme && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:markup": "node node_modules/fire-design/scripts/lint-markup.mjs src index.html",
    "lint:css": "node node_modules/fire-design/scripts/lint-css.mjs src index.html",
    "check": "node scripts/check.mjs",
    "review": "npm run build && node node_modules/fire-design/scripts/review.mjs --states"
  },
  "dependencies": {
    "fire-design": "github:vidhatanand/firedesign#v0.12.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  },
  "fire": {
    "slim": {
      "sources": [
        "src",
        "index.html"
      ],
      "out": ".fire-slim",
      "level": "component"
    },
    "review": {
      "serve": "dist",
      "spa": true,
      "out": ".fire-review",
      "setup": { "storage": { "ember-whats-new-seen": "1" } },
      "routes": [
        { "path": "/overview", "name": "overview", "states": ["loading", "empty", "error"] },
        { "path": "/logs", "name": "logs", "states": ["loaded", "loading", "empty", "error", "no-results"] },
        { "path": "/settings", "name": "settings", "states": ["ready", "loading", "error", "member"] }
      ]
    }
  }
}
