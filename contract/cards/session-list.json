{
  "id": "session-list",
  "job": "Pick up an earlier agent session, or start a new one.",
  "purpose": "Past sessions grouped by day, newest first. A title is the question trimmed to one line; the time is mono and gives way to an options button on hover. The active session has an accent wash like the active nav item, and a running one shows a live dot. A braille spinner covers loading.",
  "useWhen": [
    "An agent keeps history and people return to earlier runs.",
    "The list sits in a side column beside the thread or in a pane next to the rail."
  ],
  "avoidWhen": [
    {
      "when": "Primary navigation between app sections.",
      "instead": "sidebar"
    },
    {
      "when": "A list of ordinary records with columns.",
      "instead": "table"
    },
    {
      "when": "Past conversations with a person in a chat, with state badges.",
      "instead": "chat"
    }
  ],
  "aka": [
    "history",
    "conversations",
    "recent chats",
    "thread list",
    "sessions sidebar"
  ],
  "surfaces": [
    "app"
  ],
  "data": [
    "list"
  ],
  "states": [
    {
      "name": "active session",
      "how": "data-active on .fd-session-list-item"
    },
    {
      "name": "running",
      "how": ".fd-session-list-live in place of the time"
    },
    {
      "name": "loading",
      "how": ".fd-session-list-loading with .fd-session-list-spinner"
    },
    {
      "name": "empty",
      "how": ".fd-session-list-empty"
    }
  ],
  "variants": [
    {
      "attribute": "data-active",
      "value": "",
      "useWhen": "Marks the session on screen."
    }
  ],
  "parts": [
    {
      "class": "fd-session-list",
      "role": "The list."
    },
    {
      "class": "fd-session-list-head",
      "role": "Heading row with the title."
    },
    {
      "class": "fd-session-list-new",
      "role": "The New session button."
    },
    {
      "class": "fd-session-list-heading",
      "role": "A day label such as Today."
    },
    {
      "class": "fd-session-list-item",
      "role": "One session row."
    },
    {
      "class": "fd-session-list-link",
      "role": "The title link."
    },
    {
      "class": "fd-session-list-time",
      "role": "The time, mono.",
      "parent": ["fd-session-list-item"]
    },
    {
      "class": "fd-session-list-live",
      "role": "The live dot for a running session."
    },
    {
      "class": "fd-session-list-more",
      "role": "The options button.",
      "parent": ["fd-session-list-item"]
    },
    {
      "class": "fd-session-list-loading",
      "role": "The loading line with a spinner."
    }
  ],
  "related": [
