{
  "name": "fire-lit-vite-starter",
  "version": "0.11.0",
  "private": true,
  "description": "Fire starter: Lit components in light DOM, Vite, TypeScript. Copy this folder to start an app.",
  "type": "module",
  "scripts": {
    "prepare:fire": "node scripts/prepare.mjs",
    "dev": "npm run prepare:fire && vite",
    "build": "npm run prepare:fire && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint:markup": "node scripts/lint.mjs",
    "lint:css": "node scripts/lint.mjs --css",
    "check": "node scripts/check.mjs",
    "review": "npm run build && node node_modules/fire-design/scripts/review.mjs --states"
  },
  "dependencies": {
    "fire-design": "file:../..",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "pixelmatch": "7.1.0",
    "playwright-core": "1.64.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "fire": {
    "slim": {
      "sources": [
        "src",
        "index.html"
      ],
      "out": ".fire-slim",
      "level": "component"
    },
    "budget": {
      "initialJs": 205,
      "routeJs": 25,
      "css": 100
    },
    "review": {
      "serve": "dist",
      "spa": true,
      "out": ".fire-review",
      "setup": { "storage": { "ember-whats-new-seen": "1" } },
      "routes": [
        { "path": "/overview", "name": "overview", "states": ["loading", "empty", "error"] },
        { "path": "/logs", "name": "logs", "states": ["loaded", "loading", "empty", "error", "no-results"] },
        { "path": "/logs/req_7c19be", "name": "logs/:id" },
        { "path": "/settings", "name": "settings", "states": ["ready", "loading", "error", "member"] },
        { "path": "/elements", "name": "elements" },
        { "path": "/no-access", "name": "no-access" },
        { "path": "/billing/plans", "name": "not-found" }
      ]
    }
  }
}
