{
  "id": "doc-changelog",
  "job": "List dated releases on a rail with filters by kind or area.",
  "purpose": "Releases newest first on a rail. The date column sticks while its entry scrolls, each entry has a title, tags and a body, and filter chips narrow the list by kind or area. The newest release can be marked. An empty filter shows a message.",
  "useWhen": [
    "Product changes need a public history people can scan and filter.",
    "A release has a date, tags and notes with code or links."
  ],
  "avoidWhen": [
    {
      "when": "A sequence of events on a record, such as an audit trail.",
      "instead": "timeline"
    },
    {
      "when": "A version note in one guide.",
      "instead": "callout"
    },
    {
      "when": "A table of versions with columns.",
      "instead": "table"
    }
  ],
  "aka": [
    "release notes",
    "what's new",
    "updates",
    "product updates",
    "version history",
    "change log"
  ],
  "surfaces": [
    "website"
  ],
  "data": [
    "list"
  ],
  "states": [
    {
      "name": "latest",
      "how": "data-latest on the newest release"
    },
    {
      "name": "filtered",
      "how": "chip value matches data-tags on .fd-doc-release"
    },
    {
      "name": "no match",
      "how": ".fd-doc-releases-empty"
    }
  ],
  "variants": [
    {
      "attribute": "data-latest",
      "value": "",
      "useWhen": "The newest release, marked in accent."
    }
  ],
  "parts": [
    {
      "class": "fd-doc-changelog",
      "role": "The list."
    },
    {
      "class": "fd-doc-changelog-filters",
      "role": "The chip nav that filters releases."
    },
    {
      "class": "fd-doc-release",
      "role": "One release; takes data-tags."
    },
    {
      "class": "fd-doc-release-date",
      "role": "The sticky date column."
    },
    {
      "class": "fd-doc-release-title",
      "role": "The release title; gets an anchor."
    },
    {
      "class": "fd-doc-release-tags",
      "role": "The tags."
    },
    {
      "class": "fd-doc-release-body",
      "role": "The notes in prose."
    }
  ],
  "related": [
    "doc",
    "timeline",
    "chip-nav",
    "prose"
  ],
  "keyboard": [
    {
      "keys": "Enter, Space",
      "does": "Applies a filter chip."
    }
  ],
  "example": "docs/documentation.html#changelog",
  "provenance": [
    "docs/documentation.html",
    "fire/components/docsite.css",
    "fire/js/docsite.js",
    "templates/docs-changelog.html"
  ],
  "since": "0.1.0"
}
