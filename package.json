{
  "name": "fire-design",
  "version": "0.12.4",
  "private": true,
  "license": "MIT",
  "description": "Fire: a design system for developer, agent and AI products. Plain HTML and CSS as the contract, with Lit elements, React and Vue wrappers.",
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/serve.py 4747",
    "icons": "node scripts/build-icons.mjs node_modules/lucide-static/icons",
    "audit": "node scripts/audit.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/audit.mjs && node scripts/build-palettes.mjs --check && node --test scripts/test/*.test.mjs",
    "lint:markup": "node scripts/lint-markup.mjs",
    "lint:css": "node scripts/lint-css.mjs",
    "build:pictures": "node scripts/build-pictures.mjs",
    "release:version": "node scripts/version.mjs",
    "slim": "node scripts/slim.mjs",
    "review": "node scripts/review.mjs",
    "build:slim-map": "node scripts/build-slim-map.mjs",
    "render-equal": "node scripts/render-equal.mjs",
    "build:elements": "node scripts/build-elements.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "find": "node scripts/find.mjs",
    "build:index": "node scripts/build-index.mjs",
    "fonts": "node scripts/fonts.mjs",
    "build:typefaces": "node scripts/build-typefaces.mjs",
    "gate": "node scripts/gate.mjs",
    "looks": "node scripts/looks-check.mjs",
    "check:full": "npm run check && node scripts/gate.mjs --check && node scripts/looks-check.mjs --check"
  },
  "exports": {
    ".": "./fire/fire.js",
    "./css": {
      "types": "./fire/fire.css.d.ts",
      "default": "./fire/fire.css"
    },
    "./boot": "./fire/boot.js",
    "./transitions.css": "./fire/transitions.css",
    "./slim": "./scripts/slim.mjs",
    "./slim-map": "./contract/slim-map.json",
    "./structure": "./scripts/lib/structure.mjs",
    "./elements": {
      "types": "./fire/elements.d.ts",
      "default": "./fire/elements.js"
    },
    "./theme": {
      "types": "./fire/js/theme.d.ts",
      "default": "./fire/js/theme.js"
    },
    "./react": {
      "types": "./wrappers/react/index.d.ts",
      "default": "./wrappers/react/index.js"
    },
    "./vue": {
      "types": "./wrappers/vue/index.d.ts",
      "default": "./wrappers/vue/index.js"
    },
    "./contract": "./contract/fire-contract.json",
    "./catalog": "./contract/catalog.json",
    "./fire/*": "./fire/*",
    "./package.json": "./package.json",
    "./index": "./contract/index.json",
    "./email": {
      "types": "./fire/email/email.d.ts",
      "default": "./fire/email/email.js"
    },
    "./initial": {
      "types": "./fire/js/initial.d.ts",
      "default": "./fire/js/initial.js"
    },
    "./looks": {
      "types": "./fire/js/looks.d.ts",
      "default": "./fire/js/looks.js"
    },
    "./fonts": "./contract/fonts.json"
  },
  "types": "./fire/fire.d.ts",
  "files": [
    "fire",
    "contract",
    "!contract/pictures",
    "wrappers",
    "spec",
    "scripts/lint-markup.mjs",
    "scripts/lint-css.mjs",
    "scripts/slim.mjs",
    "scripts/review.mjs",
    "scripts/lib/slim-css.mjs",
    "scripts/lib/structure.mjs",
    "scripts/render-equal.mjs",
    "CHANGELOG.md",
    "NOTICE",
    "GUIDE.md",
    "AGENT-RULES.md",
    "WRITING.md",
    "README.md",
    "scripts/fire.mjs",
    "scripts/find.mjs",
    "scripts/fonts.mjs",
    "scripts/gate.mjs",
    "scripts/fingerprint.mjs",
    "scripts/looks-check.mjs"
  ],
  "peerDependencies": {
    "react": ">=19",
    "vue": ">=3.4",
    "@lit/react": ">=1",
    "playwright-core": ">=1.50",
    "pixelmatch": ">=7",
    "pngjs": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@lit/react": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "pixelmatch": {
      "optional": true
    },
    "pngjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "3.3.3",
    "@lit/react": "1.0.8",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "playwright-core": "1.64.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "ajv": "8.17.1"
  },
  "customElements": "contract/custom-elements.json",
  "bin": {
    "fire": "scripts/fire.mjs"
  }
}
