{
  "name": "fire-vue-vite-starter",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Fire starter: Vue 3, Vite and vue-router, TypeScript, strict CSP.",
  "scripts": {
    "theme": "node scripts/build-theme.mjs",
    "dev": "npm run theme && vite",
    "build": "npm run theme && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint:markup": "node ../../scripts/lint-markup.mjs src index.html",
    "lint:css": "node ../../scripts/lint-css.mjs src index.html",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "fire-design": "file:../..",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vue-tsc": "3.3.14"
  }
}
