{
  "id": "schema",
  "job": "Document the parameters of an endpoint: names, types, defaults and nested fields.",
  "purpose": "A list of parameters. Required ones come first, defaults are stated, enum values are listed as typed, and nested objects fold so the top level reads in one pass. Each item has a name, a type, a required or optional mark and a description. A toggle shows or hides the nested children.",
  "useWhen": [
    "An API reference lists request parameters or response fields.",
    "A form of options is documented before a call."
  ],
  "avoidWhen": [
    {
      "when": "A response shown with real values.",
      "instead": "json"
    },
    {
      "when": "Facts about one record.",
      "instead": "kv"
    },
    {
      "when": "An example request.",
      "instead": "codeblock"
    },
    {
      "when": "Settings people change.",
      "instead": "setting"
    }
  ],
  "aka": [
    "parameter list",
    "API reference",
    "field table",
    "request body",
    "properties",
    "params",
    "type table"
  ],
  "surfaces": [
