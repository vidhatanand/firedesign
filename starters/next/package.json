{
  "name": "fire-next-starter",
  "version": "0.14.1",
  "private": true,
  "description": "Fire on Next.js 16 (App Router), React 19 and TypeScript: server-rendered Fire markup, Fire's behaviour loaded on the client, a strict nonce-based CSP.",
  "type": "module",
  "scripts": {
    "prepare-fire": "node scripts/prepare-fire.mjs",
    "predev": "node scripts/prepare-fire.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-fire.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint:markup": "node node_modules/fire-design/scripts/lint-markup.mjs app",
    "lint:css": "node node_modules/fire-design/scripts/lint-css.mjs app",
    "check": "node scripts/check.mjs",
    "review": "node node_modules/fire-design/scripts/review.mjs --states"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "fire-design": "github:vidhatanand/firedesign#v0.14.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ],
  "fire": {
    "slim": {
      "sources": [
        "app"
      ],
      "out": ".fire-slim",
      "level": "component"
    },
    "review": {
      "base": "http://127.0.0.1:3000",
      "out": ".fire-review",
      "setup": { "storage": { "ember-whats-new-seen": "1" } },
      "routes": [
        { "path": "/overview", "name": "overview", "states": ["loading", "empty", "error"] },
        { "path": "/logs", "name": "logs", "states": ["loaded", "loading", "empty", "error", "no-results"] },
        { "path": "/settings", "name": "settings", "states": ["ready", "loading", "error", "member"] }
      ]
    }
  }
}
