{
  "id": "donut",
  "job": "Show parts of a whole, or one value against a known end.",
  "purpose": "A thin ring for two to five segments with the total in the centre and a legend beside it. Hover a segment or a legend row to read it in the centre. In data-type=\"progress\" it is a progress ring: one value against a known end, such as an import. A quota or limit is a meter, not a ring.",
  "useWhen": [
    "A share of a whole has two to five parts: requests by endpoint, credits by team.",
    "A single progress value needs a larger ring with a label in the middle."
  ],
  "avoidWhen": [
    {
      "when": "Use against a quota or a limit.",
      "instead": "meter"
    },
    {
      "when": "More than five parts, or parts that must be compared closely.",
      "instead": "bars"
    },
    {
      "when": "A value over time.",
      "instead": "chart"
    },
    {
      "when": "A small inline ring beside text.",
      "instead": "progress"
    }
  ],
  "aka": [
    "pie chart",
    "doughnut",
    "ring chart",
    "radial chart",
    "share chart",
    "circular progress",
    "proportion"
  ],
  "surfaces": [
    "app",
    "website"
  ],
  "data": [
    "series"
  ],
  "states": [
    {
      "name": "active",
      "how": "data-active on the segment or legend row under the pointer; its value shows in the centre"
    },
    {
      "name": "entering",
      "how": "data-enter pending, run or done; segments draw in 60ms apart"
    }
  ],
  "variants": [
    {
      "attribute": "data-type",
      "value": "progress",
      "useWhen": "One value against a known end, not parts of a whole."
    },
    {
      "attribute": "data-compact",
      "value": "",
      "useWhen": "A ring under 72px; the figure shows without a caption."
    },
    {
      "attribute": "data-tone",
      "value": "success",
      "useWhen": "A progress ring that is healthy."
    },
    {
      "attribute": "data-tone",
      "value": "danger",
      "useWhen": "A progress ring that failed."
    },
    {
      "attribute": "data-s",
      "value": "1",
      "useWhen": "Segment in chart slot 1, the accent."
    },
    {
      "attribute": "data-s",
      "value": "2",
      "useWhen": "Segment in chart slot 2, ink."
    }
