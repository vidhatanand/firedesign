{
  "id": "json",
  "job": "Explore a JSON response by folding it, not by reading it whole.",
  "purpose": "A tree rendered from data-json or a child script of type application/json. Nodes fold and show a count when folded; long strings are trimmed with a \"+N chars\" link; a hovered line offers Copy value and Copy path. data-depth sets how many levels start open. A toolbar adds a label, size, Expand all, Collapse all and Copy.",
  "useWhen": [
    "A response is explored rather than copied whole.",
    "People need the path to a nested value.",
    "A result offers a Table | JSON switch of the same data."
  ],
  "avoidWhen": [
    {
      "when": "A short request or a config to copy.",
      "instead": "codeblock"
    },
    {
      "when": "Records with the same fields.",
      "instead": "table"
    },
    {
      "when": "Parameter docs.",
      "instead": "schema"
    },
    {
      "when": "A diff between two JSON documents.",
      "instead": "diff"
    }
  ],
  "aka": [
    "JSON viewer",
    "tree view",
    "object inspector",
    "JSON explorer",
    "collapsible JSON",
    "response viewer"
  ],
  "surfaces": [
    "app",
    "website"
  ],
  "data": [
    "record"
  ],
  "states": [
    {
      "name": "open",
      "how": "aria-expanded=\"true\" on a node"
    },
    {
      "name": "copied",
      "how": "data-state=\"copied\" after a copy"
    },
    {
      "name": "container",
      "how": "data-container on a node that holds children"
    }
  ],
  "variants": [
    {
      "attribute": "data-variant",
      "value": "bare",
      "useWhen": "No frame, inside a card or a sheet."
    },
    {
      "attribute": "data-container",
      "value": "",
      "useWhen": "A node that is an object or an array."
    }
  ],
  "parts": [
    {
      "class": "fd-json",
      "role": "The block."
    },
    {
      "class": "fd-json-bar",
      "role": "The toolbar."
    },
    {
      "class": "fd-json-label",
      "role": "The toolbar label."
    },
    {
      "class": "fd-json-meta",
      "role": "The size line."
    },
    {
      "class": "fd-json-tools",
      "role": "The toolbar buttons."
    },
    {
      "class": "fd-json-btn",
      "role": "A toolbar button."
    },
    {
      "class": "fd-json-tree",
      "role": "The tree."
    },
    {
      "class": "fd-json-root",
      "role": "The root of the tree."
    },
    {
      "class": "fd-json-node",
      "role": "One key or item."
    },
    {
      "class": "fd-json-line",
      "role": "The line of a node; the focus target."
    },
    {
      "class": "fd-json-toggle",
      "role": "The fold arrow."
    },
    {
      "class": "fd-json-children",
      "role": "The nested nodes."
    },
    {
      "class": "fd-json-tail",
      "role": "The count and closing bracket of a folded node."
    },
    {
      "class": "fd-json-count",
      "role": "The number of children."
    },
    {
      "class": "fd-json-close",
      "role": "The closing bracket line."
    },
    {
      "class": "fd-json-more",
      "role": "The \"+N chars\" link of a trimmed string."
    },
    {
      "class": "fd-json-actions",
      "role": "The Copy value and Copy path buttons."
    },
    {
      "class": "fd-json-empty",
      "role": "An empty object or array."
    }
  ],
  "related": [
    "codeblock",
    "table",
    "viewswitch",
    "schema"
  ],
  "keyboard": [
    {
      "keys": "Arrow Down, Arrow Up",
      "does": "Move between visible lines."
    },
    {
      "keys": "Arrow Right",
      "does": "Opens a folded node, or moves into its first child."
    },
    {
      "keys": "Arrow Left",
      "does": "Closes an open node, or moves to its parent."
    },
    {
      "keys": "Home, End",
      "does": "Go to the first or last line."
    },
    {
      "keys": "Enter, Space",
      "does": "Toggles a node, or reveals a trimmed string."
    }
  ],
  "example": "docs/code.html#json",
  "provenance": [
    "docs/code.html",
    "fire/components/code.css",
    "fire/js/code.js"
  ],
  "since": "0.1.0"
}
