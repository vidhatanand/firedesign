{
  "id": "type",
  "job": "Set the size and weight of a heading, label or body text.",
  "purpose": "The type scale in Geist and Geist Mono: display, h1 to h3, title, label, body, small, caption, mono and eyebrow. 450 is the house weight. A page has one display title; sections use fd-h3; cards use fd-title. Mono is for identifiers, keys, paths and units, never for sentences. Figures use tabular numerals (fd-num).",
  "useWhen": [
    "Any heading, label or paragraph needs a step on the scale.",
    "A number must not jitter in a column or counter (fd-num).",
    "A machine-readable value needs the mono face."
  ],
  "avoidWhen": [
    {
      "when": "Only the colour or length changes.",
      "instead": "text"
    },
    {
      "when": "A key or command sits inside a sentence.",
      "instead": "inline-code"
    },
    {
      "when": "A heading belongs to a card, form section or page head.",
      "instead": "page-head"
    }
  ],
