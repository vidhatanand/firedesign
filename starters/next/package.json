{
  "name": "fire-next-starter",
  "version": "0.8.0",
  "private": true,
  "description": "Fire on Next.js 16 (App Router), React 19 and TypeScript: server-rendered Fire markup, Fire's behaviour loaded on the client, a strict nonce-based CSP.",
  "type": "module",
  "scripts": {
    "prepare-fire": "node scripts/prepare-fire.mjs",
    "predev": "node scripts/prepare-fire.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-fire.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint:markup": "node ../../scripts/lint-markup.mjs app",
    "lint:css": "node ../../scripts/lint-css.mjs app",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@lit/react": "1.0.8",
    "fire-design": "file:../..",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "browserslist": [
    "chrome >= 123",
    "edge >= 123",
    "firefox >= 120",
    "safari >= 17.5"
  ]
}
