{
  "name": "fire-design",
  "version": "0.6.0-dev",
  "private": true,
  "description": "Fire: a design system for developer, agent and AI products. Plain HTML and CSS as the contract, with Lit elements, React and Vue wrappers, and a Facet export.",
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/serve.py 4747",
    "icons": "node scripts/build-icons.mjs node_modules/lucide-static/icons",
    "audit": "node scripts/audit.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/audit.mjs && node scripts/build-palettes.mjs --check && node --test scripts/test/*.test.mjs",
    "lint:markup": "node scripts/lint-markup.mjs",
    "render-equal": "node scripts/render-equal.mjs"
  },
  "exports": {
    ".": "./fire/fire.js",
    "./css": "./fire/fire.css",
    "./boot": "./fire/boot.js",
    "./elements": {
      "types": "./fire/elements.d.ts",
      "default": "./fire/elements.js"
    },
    "./theme": "./fire/js/theme.js",
    "./react": {
      "types": "./wrappers/react/index.d.ts",
      "default": "./wrappers/react/index.js"
    },
    "./vue": {
      "types": "./wrappers/vue/index.d.ts",
      "default": "./wrappers/vue/index.js"
    },
    "./contract": "./contract/fire-contract.json",
    "./catalog": "./contract/catalog.json",
    "./fire/*": "./fire/*",
    "./package.json": "./package.json"
  },
  "types": "./fire/fire.d.ts",
  "files": [
    "fire",
    "contract",
    "wrappers",
    "spec",
    "scripts/lint-markup.mjs",
    "scripts/render-equal.mjs",
    "CHANGELOG.md",
    "GUIDE.md",
    "AGENT-RULES.md",
    "WRITING.md",
    "README.md"
  ],
  "peerDependencies": {
    "react": ">=19",
    "vue": ">=3.4",
    "@lit/react": ">=1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@lit/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "3.3.3",
    "@lit/react": "1.0.8",
    "typescript": "5.9.3",
    "esbuild": "0.28.2",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "playwright-core": "1.64.1",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "ajv": "8.17.1"
  },
  "customElements": ".scratch/custom-elements.json"
}
